# Dashboard Configuration
DASHBOARD_TOKEN=
DASHBOARD_DATABASE_URL=sqlite:///dashboard.db
CAPTURES_ROOT=./captures

# LLM Configuration
# Model options: llava:7b, llava:13b, llava:34b
# For RTX 5070 Ti (16GB VRAM): Use llava:13b for best quality, llava:7b for speed
LLM_MODEL=llama3.2-vision-90b
LLM_VISION_MODEL=llava:13b
LLM_TEXT_MODEL=llama3.1

# Report Settings
REPORT_DETAIL_LEVEL=comprehensive  # Options: quick, standard, comprehensive
SCREENSHOT_QUALITY=high  # Options: low, medium, high
ACTION_SCREENSHOT_ENABLED=true
LLM_ANALYSIS_ENABLED=true

# Performance Settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2  # Lower = more consistent, Higher = more creative

# OpenAI (Optional - fallback if local LLM fails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-vision-preview
